@model SmartInventory.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Store Inventory Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            <span>Store Inventory Overview</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 fw-semibold">Live Metrics</span>
        </h2>
        <p class="text-muted mb-0">Real-time retail inventory tracking, stock levels, and session audit monitoring.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
        <a asp-controller="Products" asp-action="Create" class="btn btn-outline-custom">
            <i class="bi bi-plus-lg text-primary"></i> New Product
        </a>
        <a asp-controller="Stock" asp-action="Adjust" class="btn btn-primary-custom">
            <i class="bi bi-arrow-repeat"></i> Log Stock Movement
        </a>
    </div>
</div>

<!-- Real-World Problem Alert Banner -->
@if (Model.OutOfStockCount > 0 || Model.LowStockCount > 0)
{
    <div class="alert alert-warning border border-warning shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-warning text-dark p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1 text-warning-emphasis">Stock Alert: Critical Inventory Levels Detected</h5>
                <p class="mb-0 text-secondary small">
                    You have <strong>@Model.OutOfStockCount</strong> out-of-stock items and <strong>@Model.LowStockCount</strong> items running below reorder threshold. Replenish promptly to prevent sales disruption.
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Stock" asp-action="LowStock" class="btn btn-warning fw-semibold shadow-sm">
                <i class="bi bi-shield-exclamation"></i> View Alert List (@(Model.OutOfStockCount + Model.LowStockCount))
            </a>
            <a asp-controller="Restock" asp-action="Index" class="btn btn-outline-dark fw-semibold">
                <i class="bi bi-cart3"></i> Draft Restock PO
            </a>
        </div>
    </div>
}

<!-- 4 Key Metrics Cards -->
<div class="row g-3 mb-4">
    <!-- Total Catalog & Stock Units -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card primary">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="metric-label">Total Inventory</div>
                    <div class="metric-value">@Model.TotalStockUnits.ToString("N0") <span class="fs-6 text-muted fw-normal">units</span></div>
                </div>
                <div class="metric-icon-box">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small mt-2 pt-2 border-top">
                <span>Catalog Size:</span>
                <span class="fw-semibold text-dark">@Model.TotalProducts Products</span>
            </div>
        </div>
    </div>

    <!-- Inventory Valuation -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card success">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="metric-label">Retail Valuation</div>
                    <div class="metric-value">$@Model.TotalInventoryRetail.ToString("N2")</div>
                </div>
                <div class="metric-icon-box">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small mt-2 pt-2 border-top">
                <span>Cost Basis:</span>
                <span class="fw-semibold text-dark">$@Model.TotalInventoryCost.ToString("N2")</span>
            </div>
        </div>
    </div>

    <!-- Stock Health Ratio -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card warning">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="metric-label">Healthy Stock</div>
                    <div class="metric-value">@Model.HealthyStockCount <span class="fs-6 text-muted fw-normal">/ @Model.TotalProducts</span></div>
                </div>
                <div class="metric-icon-box">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small mt-2 pt-2 border-top">
                <span>Overall Margin:</span>
                <span class="badge bg-success-subtle text-success fw-bold">+@Model.OverallMargin.ToString("F1")%</span>
            </div>
        </div>
    </div>

    <!-- Depleted / Low Stock Alerts -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card danger">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <div class="metric-label">Items Needing Restock</div>
                    <div class="metric-value text-danger">@(Model.LowStockCount + Model.OutOfStockCount)</div>
                </div>
                <div class="metric-icon-box">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
            <div class="d-flex align-items-center justify-content-between text-muted small mt-2 pt-2 border-top">
                <span>Out of Stock:</span>
                <span class="fw-bold text-danger">@Model.OutOfStockCount items</span>
            </div>
        </div>
    </div>
</div>

<!-- Mid Row: Critical Low Stock Table & Category Distribution -->
<div class="row g-4 mb-4">
    <!-- Low Stock Urgent Watchlist -->
    <div class="col-lg-8">
        <div class="inventory-card h-100">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-bell-fill text-warning"></i>
                    <span>Low Stock Priority Watchlist</span>
                </div>
                <a asp-controller="Stock" asp-action="LowStock" class="btn btn-sm btn-outline-custom">
                    View All (@(Model.LowStockCount + Model.OutOfStockCount))
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Product / SKU</th>
                            <th>Category</th>
                            <th>Stock Level</th>
                            <th>Threshold</th>
                            <th>Status</th>
                            <th class="text-end">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.LowStockProducts.Any() && !Model.OutOfStockProducts.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                                    All inventory items are currently well-stocked above reorder thresholds!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.OutOfStockProducts.Concat(Model.LowStockProducts).Take(6))
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Name</div>
                                        <span class="badge-sku">@item.SKU</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @(item.Category?.Icon ?? "bi-tag") me-1"></i>
                                            @(item.Category?.Name ?? "General")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold @(item.IsOutOfStock ? "text-danger" : "text-warning")">
                                                @item.QuantityInStock @item.Unit
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">@item.ReorderLevel @item.Unit</span>
                                    </td>
                                    <td>
                                        @if (item.IsOutOfStock)
                                        {
                                            <span class="badge-stock-out">
                                                <i class="bi bi-x-circle-fill"></i> Out of Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-stock-low">
                                                <i class="bi bi-exclamation-triangle-fill"></i> Low Stock
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <form asp-controller="Restock" asp-action="AddToCart" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Add to Restock PO Plan">
                                                    <i class="bi bi-cart-plus"></i> Restock
                                                </button>
                                            </form>
                                            <a asp-controller="Stock" asp-action="Adjust" asp-route-id="@item.Id" class="btn btn-sm btn-primary-custom" title="Stock In Delivery">
                                                <i class="bi bi-plus-lg"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Category Stock Breakdown -->
    <div class="col-lg-4">
        <div class="inventory-card h-100">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-pie-chart-fill text-primary"></i>
                    <span>Category Breakdown</span>
                </div>
                <a asp-controller="Categories" asp-action="Index" class="text-muted text-decoration-none small">Manage</a>
            </div>
            <div class="p-3">
                <div class="list-group list-group-flush">
                    @foreach (var cat in Model.CategorySummaries)
                    {
                        <div class="list-group-item px-1 py-3 border-bottom d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-light p-2 rounded-3 text-primary fs-5">
                                    <i class="bi @cat.Icon"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@cat.CategoryName</div>
                                    <div class="text-muted small">@cat.ProductCount Products &bull; @cat.TotalUnits units</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark">$@cat.TotalValue.ToString("N0")</div>
                                <span class="badge bg-light text-muted border">Valuation</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Row: Recent Stock Transactions & State Management Session Card -->
<div class="row g-4">
    <!-- Recent Stock Movements Audit Trail -->
    <div class="col-lg-8">
        <div class="inventory-card">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-clock-history text-info"></i>
                    <span>Recent Stock Activity (Audit Ledger)</span>
                </div>
                <a asp-controller="Stock" asp-action="Index" class="btn btn-sm btn-outline-custom">
                    Full Ledger
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Product</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Previous &rarr; New</th>
                            <th>Staff / Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentTransactions.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No transactions recorded yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tx in Model.RecentTransactions)
                            {
                                <tr>
                                    <td class="text-muted small">
                                        @tx.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm")
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">@(tx.Product?.Name ?? "Deleted Product")</span>
                                    </td>
                                    <td>
                                        @switch (tx.TransactionType)
                                        {
                                            case TransactionType.StockIn:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-arrow-down-left"></i> Stock In
                                                </span>
                                                break;
                                            case TransactionType.StockOut:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    <i class="bi bi-arrow-up-right"></i> Stock Out
                                                </span>
                                                break;
                                            case TransactionType.Adjustment:
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                    <i class="bi bi-sliders"></i> Adjustment
                                                </span>
                                                break;
                                            case TransactionType.Return:
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Return
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-bold @(tx.TransactionType == TransactionType.StockOut ? "text-danger" : "text-success")">
                                            @(tx.TransactionType == TransactionType.StockOut ? "-" : "+")@tx.Quantity
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@tx.PreviousStock &rarr; <strong class="text-dark">@tx.NewStock</strong></span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@tx.PerformedBy</div>
                                        <div class="text-muted small text-truncate" style="max-width: 180px;" title="@tx.Reason">@tx.Reason</div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- State Management & System Session Diagnostics -->
    <div class="col-lg-4">
        <div class="inventory-card">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-cpu text-primary"></i>
                    <span>State & Session Monitor</span>
                </div>
                <span class="badge bg-light text-dark border">HttpContext.Session</span>
            </div>
            <div class="p-3">
                <div class="mb-3 p-3 bg-light rounded-3 border">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="status-dot-pulse"></div>
                        <span class="fw-bold text-dark small text-uppercase">Active Session Telemetry</span>
                    </div>
                    <ul class="list-unstyled mb-0 small">
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Total Session Operations:</span>
                            <span class="fw-bold text-primary">@Model.SessionAuditCount actions</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Restock Draft PO Items:</span>
                            <span class="fw-bold text-dark">@Model.SessionRestockDraftCount items</span>
                        </li>
                        <li class="py-1">
                            <span class="text-muted d-block">Last Performed Action:</span>
                            <span class="fw-semibold text-dark d-block text-truncate" title="@(Model.LastActionSummary ?? "Session initialized")">
                                @(Model.LastActionSummary ?? "System started. Ready for operations.")
                            </span>
                        </li>
                    </ul>
                </div>

                <div class="p-3 bg-light rounded-3 border">
                    <div class="fw-bold text-dark small text-uppercase mb-2">
                        <i class="bi bi-database me-1 text-primary"></i> Database Architecture
                    </div>
                    <div class="small mb-1">
                        <span class="text-muted">Provider:</span>
                        <strong class="text-dark">@Model.DatabaseStatus</strong>
                    </div>
                    <p class="text-muted small mb-0">
                        Configured via <code>Pomelo.EntityFrameworkCore.MySql</code> connected to MySQL default port 3306.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
