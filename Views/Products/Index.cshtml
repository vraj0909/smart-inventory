@model SmartInventory.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products & Stock Catalog";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Products & Stock Inventory</h2>
        <p class="text-muted mb-0">Manage store items, monitor stock levels, and control reorder thresholds.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-custom">
            <i class="bi bi-file-earmark-arrow-down text-success"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-lg"></i> Add New Product
        </a>
    </div>
</div>

<!-- Filter Bar Card -->
<div class="inventory-card p-3 mb-4">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-center">
            <!-- Search Keyword -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0 form-control-custom" placeholder="Search by product name or SKU..." />
                </div>
            </div>

            <!-- Category Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="categoryId" asp-items="@Model.CategoryList" class="form-select form-select-custom">
                    <option value="">All Categories</option>
                </select>
            </div>

            <!-- Supplier Filter -->
            <div class="col-sm-6 col-md-2">
                <select name="supplierId" asp-items="@Model.SupplierList" class="form-select form-select-custom">
                    <option value="">All Suppliers</option>
                </select>
            </div>

            <!-- Sort By -->
            <div class="col-sm-6 col-md-2">
                <select name="sortOrder" class="form-select form-select-custom">
                    <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Name (A &rarr; Z)</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name (Z &rarr; A)</option>
                    <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Price (Low &rarr; High)</option>
                    <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price (High &rarr; Low)</option>
                    <option value="stock_asc" selected="@(Model.SortOrder == "stock_asc")">Stock (Lowest First)</option>
                    <option value="stock_desc" selected="@(Model.SortOrder == "stock_desc")">Stock (Highest First)</option>
                </select>
            </div>

            <!-- Buttons -->
            <div class="col-sm-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-grow-1 justify-content-center">
                    Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-custom" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </div>

        <!-- Quick Status Pills -->
        <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top align-items-center">
            <span class="text-muted small fw-bold text-uppercase me-2">Quick Status:</span>
            
            <a asp-action="Index" asp-route-statusFilter="@StockStatusFilter.All" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-supplierId="@Model.SupplierId"
               class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.StatusFilter == StockStatusFilter.All ? "bg-dark text-white" : "bg-light text-dark border")">
                All Items (@Model.TotalAllCount)
            </a>

            <a asp-action="Index" asp-route-statusFilter="@StockStatusFilter.InStock" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-supplierId="@Model.SupplierId"
               class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.StatusFilter == StockStatusFilter.InStock ? "bg-success text-white" : "bg-success-subtle text-success border border-success-subtle")">
                In Stock
            </a>

            <a asp-action="Index" asp-route-statusFilter="@StockStatusFilter.LowStock" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-supplierId="@Model.SupplierId"
               class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.StatusFilter == StockStatusFilter.LowStock ? "bg-warning text-dark" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                <i class="bi bi-exclamation-triangle-fill"></i> Low Stock (@Model.LowStockCount)
            </a>

            <a asp-action="Index" asp-route-statusFilter="@StockStatusFilter.OutOfStock" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-supplierId="@Model.SupplierId"
               class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.StatusFilter == StockStatusFilter.OutOfStock ? "bg-danger text-white" : "bg-danger-subtle text-danger border border-danger-subtle")">
                <i class="bi bi-x-circle-fill"></i> Out of Stock (@Model.OutOfStockCount)
            </a>
        </div>
    </form>
</div>

<!-- Products Table Card -->
<div class="inventory-card">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>SKU & Product</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th class="text-end">Cost / Selling</th>
                    <th class="text-center">Margin</th>
                    <th class="text-center">Stock Level</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
                            <h5 class="fw-bold">No products match your criteria</h5>
                            <p class="small mb-3">Try adjusting your filters or search keywords.</p>
                            <a asp-action="Index" class="btn btn-sm btn-outline-custom">Clear All Filters</a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.Name</div>
                                <span class="badge-sku">@item.SKU</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(item.Category?.Icon ?? "bi-tag") me-1 text-primary"></i>
                                    @(item.Category?.Name ?? "Unassigned")
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@(item.Supplier?.Name ?? "None")</div>
                                <div class="text-muted small">@(item.Supplier?.ContactPerson)</div>
                            </td>
                            <td class="text-end">
                                <div class="text-muted small">Cost: $@item.PurchasePrice.ToString("N2")</div>
                                <div class="fw-bold text-dark">$@item.SellingPrice.ToString("N2")</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">
                                    +@item.ProfitMargin%
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="fw-bold @(item.IsOutOfStock ? "text-danger" : (item.IsLowStock ? "text-warning" : "text-dark"))">
                                    @item.QuantityInStock <span class="fw-normal text-muted small">@item.Unit</span>
                                </div>
                                <div class="text-muted small">Min: @item.ReorderLevel @item.Unit</div>
                            </td>
                            <td>
                                @if (item.IsOutOfStock)
                                {
                                    <span class="badge-stock-out">
                                        <i class="bi bi-x-circle-fill"></i> Depleted
                                    </span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge-stock-low">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-stock-instock">
                                        <i class="bi bi-check-circle-fill"></i> In Stock
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit Product">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Stock" asp-action="Adjust" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Stock Adjustment">
                                        <i class="bi bi-sliders"></i>
                                    </a>
                                    
                                    <!-- Restock PO button -->
                                    <form asp-controller="Restock" asp-action="AddToCart" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-success" title="Add to Restock Draft PO">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </form>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalMatchingCount))</strong> of <strong>@Model.TotalMatchingCount</strong> products
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-categoryId="@Model.CategoryId" 
                           asp-route-supplierId="@Model.SupplierId" 
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-sortOrder="@Model.SortOrder">Previous</a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i" 
                               asp-route-searchTerm="@Model.SearchTerm" 
                               asp-route-categoryId="@Model.CategoryId" 
                               asp-route-supplierId="@Model.SupplierId" 
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-sortOrder="@Model.SortOrder">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage + 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-categoryId="@Model.CategoryId" 
                           asp-route-supplierId="@Model.SupplierId" 
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-sortOrder="@Model.SortOrder">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
