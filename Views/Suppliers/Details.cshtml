@model SmartInventory.Models.Supplier
@{
    ViewData["Title"] = $"Supplier Profile - {Model.Name}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-muted text-decoration-none small mb-1 d-inline-block">
            <i class="bi bi-arrow-left"></i> Back to Suppliers
        </a>
        <h2 class="fw-bold text-dark mb-0">@Model.Name</h2>
        <span class="text-muted">Contact Person: <strong>@Model.ContactPerson</strong></span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-custom">
            <i class="bi bi-pencil"></i> Edit Profile
        </a>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary-custom">
            <i class="bi bi-plus-lg"></i> Add Product for Supplier
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Contact Info Card -->
    <div class="col-lg-4">
        <div class="inventory-card">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-card-text text-primary"></i>
                    <span>Contact Details</span>
                </div>
            </div>
            <div class="p-4">
                <ul class="list-unstyled mb-0 small">
                    <li class="py-2 border-bottom">
                        <span class="text-muted d-block">Email:</span>
                        <a href="mailto:@Model.Email" class="fw-semibold text-primary">@Model.Email</a>
                    </li>
                    <li class="py-2 border-bottom">
                        <span class="text-muted d-block">Phone:</span>
                        <a href="tel:@Model.Phone" class="fw-semibold text-dark">@Model.Phone</a>
                    </li>
                    <li class="py-2 border-bottom">
                        <span class="text-muted d-block">Physical Address:</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</span>
                    </li>
                    <li class="py-2 border-bottom">
                        <span class="text-muted d-block">City:</span>
                        <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.City) ? "N/A" : Model.City)</span>
                    </li>
                    <li class="py-2">
                        <span class="text-muted d-block">Registered:</span>
                        <span class="text-dark">@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Products Supplied Table -->
    <div class="col-lg-8">
        <div class="inventory-card">
            <div class="card-header-clean">
                <div class="card-title-clean">
                    <i class="bi bi-box-seam text-primary"></i>
                    <span>Supplied Products (@Model.Products.Count)</span>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-modern">
                    <thead>
                        <tr>
                            <th>Product / SKU</th>
                            <th>Category</th>
                            <th>Cost / Selling</th>
                            <th>Current Stock</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Products.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No products assigned to this supplier yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model.Products)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@p.Name</div>
                                        <span class="badge-sku">@p.SKU</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(p.Category?.Name ?? "General")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small text-muted">Cost: $@p.PurchasePrice.ToString("N2")</div>
                                        <div class="small fw-bold text-dark">Sell: $@p.SellingPrice.ToString("N2")</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(p.IsOutOfStock ? "text-danger" : (p.IsLowStock ? "text-warning" : "text-dark"))">
                                            @p.QuantityInStock @p.Unit
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
