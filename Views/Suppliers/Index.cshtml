@model IEnumerable<SmartInventory.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers Directory";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Suppliers & Vendor Directory</h2>
        <p class="text-muted mb-0">Organized supplier records, direct contacts, and associated inventory lines.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-person-plus-fill"></i> Add New Supplier
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-xl-6">
            <div class="inventory-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi bi-truck"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@item.Name</h5>
                                <span class="text-muted small">Contact: <strong>@item.ContactPerson</strong></span>
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="row g-2 small text-secondary">
                            <div class="col-sm-6">
                                <i class="bi bi-envelope-at text-primary me-1"></i>
                                <a href="mailto:@item.Email" class="text-decoration-none text-dark">@item.Email</a>
                            </div>
                            <div class="col-sm-6">
                                <i class="bi bi-telephone text-primary me-1"></i>
                                <a href="tel:@item.Phone" class="text-decoration-none text-dark">@item.Phone</a>
                            </div>
                            <div class="col-12">
                                <i class="bi bi-geo-alt text-primary me-1"></i>
                                <span>@item.Address, @item.City</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-box-seam me-1 text-primary"></i> @item.Products.Count Supplied Products
                    </span>
                    <a asp-controller="Products" asp-action="Index" asp-route-supplierId="@item.Id" class="text-primary small fw-semibold text-decoration-none">
                        View Products &rarr;
                    </a>
                </div>
            </div>
        </div>
    }
</div>
